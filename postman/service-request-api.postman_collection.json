{
  "info": {
    "name": "Service Request API",
    "description": "API tests for the Public Service Request Portal. Run with Newman or import into Postman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Smoke",
      "item": [
        {
          "name": "Health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"App reports ok\", () => pm.expect(pm.response.json().status).to.eql(\"ok\"));",
                  "pm.test(\"Responds in under 500 ms\", () => pm.expect(pm.response.responseTime).to.be.below(500));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Submit request",
      "item": [
        {
          "name": "Submit valid request",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201 Created\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test(\"Tracking ID has format SR-YYYY-NNNNN\", () => pm.expect(body.tracking_id).to.match(/^SR-\\d{4}-\\d{5}$/));",
                  "pm.test(\"New request starts as Submitted\", () => pm.expect(body.status).to.eql(\"Submitted\"));",
                  "pm.test(\"Citizenship number is masked\", () => pm.expect(body.citizenship_no).to.eql(\"XX-XX-XX-X1234\"));",
                  "pm.collectionVariables.set(\"trackingId\", body.tracking_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/requests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "requests"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Sita Sharma\",\n  \"citizenship_no\": \"12-01-75-01234\",\n  \"district\": \"Morang\",\n  \"phone\": \"9841234567\",\n  \"service_type\": \"Citizenship Copy\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Reject 11-digit phone",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 422\", () => pm.response.to.have.status(422));",
                  "pm.test(\"Error is on the phone field\", () => pm.expect(pm.response.json().errors).to.have.property(\"phone\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/requests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "requests"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Sita Sharma\",\n  \"citizenship_no\": \"12-01-75-01234\",\n  \"district\": \"Morang\",\n  \"phone\": \"98412345678\",\n  \"service_type\": \"Citizenship Copy\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Reject unknown district",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 422\", () => pm.response.to.have.status(422));",
                  "pm.test(\"Error is on the district field\", () => pm.expect(pm.response.json().errors).to.have.property(\"district\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/requests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "requests"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Sita Sharma\",\n  \"citizenship_no\": \"12-01-75-01234\",\n  \"district\": \"Gotham\",\n  \"phone\": \"9841234567\",\n  \"service_type\": \"Citizenship Copy\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Track request",
      "item": [
        {
          "name": "Get request by tracking ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Returns the same request\", () => pm.expect(body.tracking_id).to.eql(pm.collectionVariables.get(\"trackingId\")));",
                  "pm.test(\"Phone number is not exposed\", () => pm.expect(body).to.not.have.property(\"phone\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/requests/{{trackingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "requests",
                "{{trackingId}}"
              ]
            }
          }
        },
        {
          "name": "Unknown tracking ID returns 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/requests/SR-1999-99999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "requests",
                "SR-1999-99999"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Officer status updates",
      "item": [
        {
          "name": "Status change without token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/requests/{{trackingId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "requests",
                "{{trackingId}}",
                "status"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"In Review\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Cannot skip review",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 422\", () => pm.response.to.have.status(422));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{officerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/requests/{{trackingId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "requests",
                "{{trackingId}}",
                "status"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Approved\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Move to In Review",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Status is now In Review\", () => pm.expect(pm.response.json().status).to.eql(\"In Review\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{officerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/requests/{{trackingId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "requests",
                "{{trackingId}}",
                "status"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"In Review\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Reject without reason",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 422\", () => pm.response.to.have.status(422));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{officerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/requests/{{trackingId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "requests",
                "{{trackingId}}",
                "status"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Rejected\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Approve",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Status is now Approved\", () => pm.expect(body.status).to.eql(\"Approved\"));",
                  "pm.test(\"History has 3 steps\", () => pm.expect(body.history.map(h => h.status)).to.eql([\"Submitted\", \"In Review\", \"Approved\"]));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{officerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/requests/{{trackingId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "requests",
                "{{trackingId}}",
                "status"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Approved\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "trackingId",
      "value": ""
    }
  ]
}